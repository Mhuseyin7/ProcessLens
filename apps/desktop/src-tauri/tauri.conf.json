{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ProcessLens",
  "version": "0.1.0",
  "identifier": "dev.processlens.desktop",
  "build": { "frontendDist": "../dist", "devUrl": "http://localhost:1420", "beforeDevCommand": "npm run dev", "beforeBuildCommand": "npm run build" },
  "app": { "windows": [{ "title": "ProcessLens", "width": 1100, "height": 760, "minWidth": 760, "minHeight": 560 }], "security": { "csp": "default-src 'self'; style-src 'self' 'unsafe-inline';" } },
  "bundle": { "active": true, "targets": "all", "icon": [] }
}
